# Mot de passe pour accéder à l'interface d'administration
ADMIN_PASSWORD=change-moi

# Clé utilisée pour signer le cookie de session admin (chaîne aléatoire longue)
SESSION_SECRET=change-moi-aussi

# Port d'écoute du serveur
PORT=3000

# Chemin du fichier de stockage JSON (par défaut ./data/data.json)
DATA_PATH=./data/data.json
